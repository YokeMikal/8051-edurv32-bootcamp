0000          ORG 0000h
              ; [label start @ 0000h]
0000  74 00     (len=2)  MOV A, #00h         ; [0000] 74 00 -> A=00h
0002  7A 04     (len=2)  MOV R2, #04h        ; [0002] 7A 04 -> R2=04h
              ; [label loop_sum @ 0004h]
0004  24 03     (len=2)  ADD A, #03h         ; [0004] 24 03 -> A += 3 (4 times -> 0Ch)
0006  DA FC     (len=2)  DJNZ R2, loop_sum   ; [0006] DA FC -> R2-- ; loop if != 0
0008  F5 30     (len=2)  MOV 30h, A          ; [0008] F5 30 -> RAM[30h]=0Ch
000A  80 02     (len=2)  SJMP after_trap     ; [000A] 80 02 -> skip trap instruction
              ; [label trap @ 000Ch]
000C  74 FF     (len=2)  MOV A, #0FFh        ; [000C] 74 FF -> MUST NOT EXECUTE
              ; [label after_trap @ 000Eh]
000E  12 00 20  (len=3)  LCALL add_ten       ; [000E] 12 00 20 -> push 0011h (SP: 07h->09h), PC=0020h
              ; [label ret_point @ 0011h]
0011  F5 31     (len=2)  MOV 31h, A          ; [0011] F5 31 -> RAM[31h]=16h (0Ch + 0Ah)
0013  78 40     (len=2)  MOV R0, #40h        ; [0013] 78 40 -> R0=40h
0015  F6        (len=1)  MOV @R0, A          ; [0015] F6    -> RAM[40h]=16h (indirect DATA write)
0016  75 90 7F  (len=3)  MOV P1, #7Fh        ; [0016] 75 90 7F -> completion sentinel
              ; [label done_b @ 0019h]
0019  80 FE     (len=2)  SJMP done_b         ; [0019] 80 FE
0020          ORG 0020h
              ; [label add_ten @ 0020h]
0020  24 0A     (len=2)  ADD A, #0Ah         ; [0020] 24 0A -> A = 0Ch + 0Ah = 16h
0022  22        (len=1)  RET                 ; [0022] 22    -> pop 0011h (SP: 09h->07h), PC=0011h
              END
