0000          ORG 0000h
              ; [label start @ 0000h]
0000  74 55     (len=2)  MOV A, #55h         ; A = 55h
0002  F5 80     (len=2)  MOV P0, A           ; P0 = 55h
0004  F4        (len=1)  CPL A               ; A = AAh
0005  F5 30     (len=2)  MOV 30h, A          ; RAM[30h] = AAh
0007  75 90 7F  (len=3)  MOV P1, #7Fh        ; Signal completion to TB
              ; [label done @ 000Ah]
000A  80 FE     (len=2)  SJMP done
              END
